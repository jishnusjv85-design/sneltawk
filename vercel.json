{
  "version": 2,
  "builds": [
    {
      "src": "api/tawk.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/tawk",
      "dest": "api/tawk.py"
    },
    {
      "src": "/tawk",
      "dest": "api/tawk.py"
    },
    {
      "src": "/",
      "dest": "api/tawk.py"
    }
  ]
}
